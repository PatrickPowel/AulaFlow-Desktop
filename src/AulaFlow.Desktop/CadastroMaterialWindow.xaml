<Window x:Class="AulaFlow.Desktop.CadastroMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastrar material - AulaFlow"
        Height="700"
        Width="680"
        MinHeight="600"
        MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock x:Name="TituloFormulario"
                       Text="Cadastrar material"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Gerencie as informações do material audiovisual."
                       FontSize="14"
                       Foreground="#607086"
                       Margin="0,8,0,25"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25">

                <StackPanel>

                    <!-- NOME -->
                    <TextBlock Text="Nome do material"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="TxtNome"
                             Height="35"
                             Padding="8,5"
                             Margin="0,8,0,20"/>

                    <!-- TIPO -->
                    <TextBlock Text="Tipo de material"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="CmbTipo"
                              Height="35"
                              Margin="0,8,0,20"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Selecione"/>
                        <ComboBoxItem Content="Vídeo"/>
                        <ComboBoxItem Content="Áudio"/>
                        <ComboBoxItem Content="Documento"/>

                    </ComboBox>

                    <!-- CURSO -->
                    <TextBlock Text="Curso"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="TxtCurso"
                             Height="35"
                             Padding="8,5"
                             Margin="0,8,0,20"/>

                    <!-- DISCIPLINA -->
                    <TextBlock Text="Disciplina"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="TxtDisciplina"
                             Height="35"
                             Padding="8,5"
                             Margin="0,8,0,20"/>

                    <!-- ARQUIVO -->
                    <TextBlock Text="Caminho do arquivo"
                               FontWeight="SemiBold"/>

                    <Grid Margin="0,8,0,25">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtArquivo"
                                 Grid.Column="0"
                                 Height="35"
                                 Padding="8,5"/>

                        <Button Grid.Column="1"
                                Content="Procurar..."
                                Height="35"
                                Margin="8,0,0,0"
                                Click="ProcurarArquivo_Click"/>

                    </Grid>

                    <!-- STATUS -->
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="CmbStatus"
                              Height="35"
                              Margin="0,8,0,25"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Pendente"/>
                        <ComboBoxItem Content="Em processamento"/>
                        <ComboBoxItem Content="Concluído"/>
                        <ComboBoxItem Content="Erro"/>

                    </ComboBox>

                    <!-- SALVAR -->
                    <Button x:Name="BtnSalvar"
                            Content="Salvar material"
                            Height="45"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="14"
                            Cursor="Hand"
                            Click="SalvarMaterial_Click"/>

                    <Button Content="Cancelar"
                            Height="38"
                            Margin="0,10,0,0"
                            Background="#E2E8F0"
                            Foreground="#172B4D"
                            Click="Cancelar_Click"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>
</Window>
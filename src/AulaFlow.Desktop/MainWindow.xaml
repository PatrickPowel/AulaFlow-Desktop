<Window x:Class="AulaFlow.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AulaFlow • Operação audiovisual" Width="1220" Height="790" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F4F7FB">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B4D"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#172B4D" Padding="22,30"><StackPanel><TextBlock Text="AulaFlow" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="ESTÚDIO / DESKTOP" Foreground="#94B5D1" FontSize="11" Margin="0,8,0,40"/><Border Background="#087F8C" CornerRadius="8" Padding="12"><TextBlock Text="▣  Materiais" Foreground="White" FontWeight="SemiBold"/></Border><TextBlock Text="Operação audiovisual" Foreground="#C1CEDC" Margin="0,22,0,0" TextWrapping="Wrap"/><TextBlock Text="Vídeos, áudios e documentos em um só catálogo." Foreground="#94B5D1" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="PORTFÓLIO INDEPENDENTE" Foreground="#94B5D1" FontSize="10" Margin="0,60,0,0"/></StackPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30">
<DockPanel><Button DockPanel.Dock="Right" Content="+ Novo material" Background="#0755ED" Foreground="White" Click="CadastrarMaterial_Click"/><StackPanel><TextBlock Text="Painel de materiais" FontSize="28" FontWeight="Bold" Foreground="#172B4D"/><TextBlock Text="Organize a produção. Encontre o próximo passo." Foreground="#607086" Margin="0,8,0,0"/></StackPanel></DockPanel>
<Border Background="#0755ED" CornerRadius="12" Padding="22" Margin="0,22,0,18"><StackPanel><TextBlock Text="Da aula gravada ao material organizado" FontSize="22" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Cadastre seus arquivos, acompanhe o status e organize cópias por curso e disciplina." TextWrapping="Wrap" Foreground="White" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,18"><TextBlock x:Name="TxtResumo" FontSize="16" Foreground="#172B4D"/></Border>
<WrapPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="Buscar nome, curso, disciplina ou tipo" Foreground="#607086" Margin="0,0,0,6"/><TextBox x:Name="TxtBusca" Width="340" Padding="10" TextChanged="Filtros_Changed"/></StackPanel><StackPanel Margin="15,0,0,0"><TextBlock Text="Status" Foreground="#607086" Margin="0,0,0,6"/><ComboBox x:Name="FiltroStatus" Width="185" Padding="8" SelectedIndex="0" SelectionChanged="Filtros_Changed"><ComboBoxItem Content="Todos os status"/><ComboBoxItem Content="Pendente"/><ComboBoxItem Content="Em processamento"/><ComboBoxItem Content="Concluído"/><ComboBoxItem Content="Erro"/></ComboBox></StackPanel></WrapPanel>
<DataGrid x:Name="GridMateriais" Height="230" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Background="White" AlternatingRowBackground="#F1F7FA" RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns>
<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/><DataGridTextColumn Header="Material" Binding="{Binding Nome}" Width="2*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="85"/><DataGridTextColumn Header="Curso" Binding="{Binding Curso}" Width="*"/><DataGridTextColumn Header="Disciplina" Binding="{Binding Disciplina}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="Cadastro" Binding="{Binding DataCadastro, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
</DataGrid.Columns></DataGrid>
<TextBlock x:Name="TxtResultado" Foreground="#607086" Margin="0,8,0,18"/>
<WrapPanel><Button Content="Editar" Click="EditarMaterial_Click"/><Button Content="Excluir cadastro" Foreground="#B42318" Click="ExcluirMaterial_Click"/><Button Content="Atualizar" Click="AtualizarLista_Click"/><Button Content="Abrir arquivo" Click="AbrirArquivo_Click"/><Button x:Name="BtnOrganizar" Content="Copiar por curso/disciplina" Click="Organizar_Click"/><Button Content="Exportar CSV" Click="Exportar_Click"/></WrapPanel>
<TextBlock Text="Os arquivos originais são preservados. Status é um acompanhamento manual da operação." Foreground="#607086" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></Grid></Window>